<Project Sdk="Microsoft.NET.Sdk">
  <!-- The in-game menu's builders and views, loaded by the mod (UiAssembly) from its folder and reloadable in a
       running game ("Reload UI"). Not a plugin: BepInEx does not load it. Builds against the ORIGINAL game
       assemblies (Managed.orig), like the mod. -->
  <PropertyGroup>
    <AssemblyName>CastleStoryPlus.UI</AssemblyName>
    <RootNamespace>CastleStoryPlus</RootNamespace>
    <VanillaManagedDir>$(GameDir)Castle Story_Data/Managed.orig/</VanillaManagedDir>
    <BepInExCoreDir>$(GameDir)BepInEx/core/</BepInExCoreDir>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mod: loaded already when this is, so never copied next to it. -->
    <ProjectReference Include="..\CastleStoryPlus\CastleStoryPlus.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Game code, publicized so patches can reach private members. -->
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true">
      <HintPath>$(VanillaManagedDir)Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brix.Core" Publicize="true">
      <HintPath>$(VanillaManagedDir)Brix.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="brix-common">
      <HintPath>$(VanillaManagedDir)brix-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Networking" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.Networking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GameManagedDir)System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Publicized for the Lua compile cache (copies compiled instructions between scripts). -->
    <Reference Include="MoonSharp.Interpreter" Publicize="true">
      <HintPath>$(GameManagedDir)MoonSharp.Interpreter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Smooth.Foundations">
      <HintPath>$(GameManagedDir)Smooth.Foundations.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(BepInExCoreDir)Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rewired_Core">
      <HintPath>$(GameManagedDir)Rewired_Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Next to the mod in the game's BepInEx/plugins/CastleStoryPlus folder, where UiAssembly reads it. -->
  <Target Name="InstallUi" AfterTargets="Build" Condition="Exists('$(GameDir)BepInEx/plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx/plugins/CastleStoryPlus/" />
  </Target>
</Project>
